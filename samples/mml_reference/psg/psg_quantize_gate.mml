/* ゲート時間 q / @q のサンプルです (全音源共通) */
; q<n>  = ゲートタイム比率 (1-8。標準は 7)。大きいほど音が長く、小さいほど
;        歯切れのよいスタッカートになります (8 = 音長いっぱいまで鳴るスラー)。
; @q<n> = フレーム単位のゲートカット。音符の末尾を n フレーム (1/60 秒単位) だけ
;        強制消音します (0 = カットなし)。指定中は q より優先されます。

#TITLE "PSG Quantize Gate"
#COMPOSER "Hotate"
#OPM OFF
#OCTAVE NORMAL

P1 t120 o4 l8           ; --- q: ゲートタイム比率 (8 → 1) ---
P1 q8 cccc              ; q8 = ゲート = 音長 (音がつながって聞こえる)
P1 q7 dddd              ; q7 = 標準のゲート
P1 q6 eeee
P1 q5 ffff
P1 q4 gggg
P1 q3 aaaa
P1 q2 bbbb
P1 q1 >cccc             ; q1 = 最短 (はっきりとしたスタッカート)

P1 o4                   ; --- @q: フレーム単位のゲートカット (0 → 7 フレーム) ---
P1 @q0 cccc             ; @q0 = カットなし (のびやか)
P1 @q1 dddd
P1 @q2 eeee
P1 @q3 ffff
P1 @q4 gggg
P1 @q5 aaaa
P1 @q6 bbbb
P1 @q7 >cccc            ; @q7 = 末尾 7 フレーム (約 0.12 秒) をカット

