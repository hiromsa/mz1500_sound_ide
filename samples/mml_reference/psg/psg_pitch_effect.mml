/* ピッチ効果 @PE / @SW / D のサンプルです (PSG) */
; D   = ディチューン (レジスタ差分値でピッチを微調整。正 = 上 / 負 = 下)
; @SW = 毎フレーム指定値ずつピッチを連続変化 (スイープ・効果音向き)
; @PE = 定義済みピッチエンベロープの適用 (ビブラート・音程変化)
; 解除は D0 / @SW0 / @PE255。

#TITLE "PSG Pitch Effect"
#COMPOSER "Hotate"
#OPM OFF
#OCTAVE NORMAL

@PE1 = { |, 0, 4, 0, -4 }       ; なめらかなビブラート
@PE2 = { |, 0, 15, 0, -15 }     ; 深いビブラート

P1 t120 o4 l4 v15 q8
P1 cccc              ; 通常の音 (比較用)
P1 D40 dddd          ; D+40 = 高めのピッチ
P1 D-40 eeee         ; D-40 = 低めのピッチ
P1 D0 ffff           ; D0 = 解除
P1 @PE1 gggg         ; @PE1 = なめらかなビブラート
P1 @PE2 aaaa         ; @PE2 = 深いビブラート
P1 @PE255 @SW2 bbbb  ; @SW+2 = だんだん上がるスイープ
P1 @SW-5 cccc        ; @SW-5 = だんだん下がるスイープ
P1 @SW0 d1           ; 解除して戻る
