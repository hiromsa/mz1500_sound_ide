/* FM 専用音量 @v (0-127) のサンプルです */
; @v は FM トラック (F1-F8) 専用の高分解能音量指定です。
; YM2151 の TL (Total Level) へ「TL = 127 - @v」で反映されます。
; PSG 用の音量コマンド v (0-15) とは別物なので注意してください。

#TITLE "FM Volume @v"
#COMPOSER "Hotate"
#OPM ON
#OCTAVE NORMAL

; --- FM 音色定義 @1 (単純な ALG4 音) ---
@1 = {
  4, 6,
  31, 12,  0, 15,  3, 24, 0, 1, 0, 0, 0,
  31, 18,  0, 12,  5, 18, 0, 2, 3, 0, 0,
  31, 10,  0, 15,  2, 30, 0, 1, 0, 0, 0,
  31,  8,  0,  8,  4,  0, 0, 1, 0, 0, 0
}

F1 t120 o4 l4 @1 q7
F1 @v127 cccc    ; @v127 = 最大音量
F1 @v100 dddd    ; @v100
F1 @v80  eeee    ; @v80
F1 @v60  ffff    ; @v60
F1 @v40  gggg    ; @v40
F1 @v20  aaaa    ; @v20
F1 @v10  bbbb    ; @v10 (かすかに聞こえる)
F1 @v5   >cccc   ; @v5   (ほぼ無音)
F1 @v0   dddd    ; @v0   = 無音
