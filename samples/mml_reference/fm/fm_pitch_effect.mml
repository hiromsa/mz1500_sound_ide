/* FM のピッチ効果 D / @SW / @PE のサンプルです */
; D   = ディチューン (レジスタ差分値でトラック全体のピッチを微調整)
; @SW = 毎フレーム指定値ずつピッチを連続変化 (スイープ)
; @PE = 定義済みピッチエンベロープの適用 (ビブラート等)
; 解除は D0 / @SW0 / @PE255。

#TITLE "FM Pitch Effect"
#COMPOSER "Hotate"
#OPM ON
#OCTAVE NORMAL

; --- ピッチエンベロープ定義 ---
@PE1 = { |, 0, 4, 0, -4 }      ; なめらかなビブラート
@PE2 = { |, 0, 15, 0, -15 }    ; 深いビブラート

; --- FM 音色定義 @1 ---
@1 = {
  4, 6,
  31, 12,  0, 15,  3, 24, 0, 1, 0, 0, 0,
  31, 18,  0, 12,  5, 18, 0, 2, 3, 0, 0,
  31, 10,  0, 15,  2, 30, 0, 1, 0, 0, 0,
  31,  8,  0,  8,  4,  0, 0, 1, 0, 0, 0
}

F1 t120 o5 l4 @1 @v100 q8
F1 cccc               ; 通常の音 (比較用)
F1 D30 dddd           ; D+30 = 少し高めに鳴る
F1 D-30 eeee          ; D-30 = 少し低めに鳴る
F1 D0 ffff            ; D0 = 解除
F1 @PE1 gggg          ; @PE1 = なめらかなビブラート
F1 @PE2 aaaa          ; @PE2 = 深いビブラート
F1 @PE255 @SW2 bbbb   ; @SW+2 = だんだん上がるスイープ
F1 @SW-5 cccc         ; @SW-5 = だんだん下がるスイープ
F1 @SW0 d1            ; 解除して戻る
