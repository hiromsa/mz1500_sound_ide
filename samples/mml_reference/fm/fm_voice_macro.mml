/* FM 音色マクロ @<番号> / @FM<番号> のサンプルです */
; @<番号> = { ... } で YM2151 の 4 オペレータ音色を定義します (46 パラメータ)。
; 定義順: ALG, FB, そして OP1〜OP4 各 11 値
;   (AR, D1R, D2R, RR, D1L, TL, KS, MUL, DT1, DT2, AME)。
; トラック内で @1 / @2 のように書くと音色を切り替えられます (@FM1 も同義)。

#TITLE "FM Voice Macro"
#COMPOSER "Hotate"
#OPM ON
#OCTAVE NORMAL

; --- @1: トランペット風 (ALG4 = モジュレータ 2 段 + キャリア) ---
@1 = {
  4, 5,
  31, 10,  0, 12,  0, 20, 0, 1, 0, 0, 0,
  31, 14,  0, 10,  0, 16, 0, 2, 0, 0, 0,
  31,  8,  0, 12,  0, 26, 0, 1, 0, 0, 0,
  31,  6,  0,  8,  0,  0, 0, 1, 0, 0, 0
}

; --- @2: ベル風 (ALG7 = 全オペレータがキャリア) ---
@2 = {
  7, 0,
  31, 20,  0,  8,  0, 18, 0, 1, 0, 0, 0,
  31, 24,  0,  8,  0, 24, 0, 2, 0, 0, 0,
  31, 16,  0,  6,  0, 30, 0, 4, 0, 0, 0,
  31, 12,  0,  6,  0, 16, 0, 8, 0, 0, 0
}

F1 t120 o5 l4 @1 @v100 q7
F1 c d e f         ; @1 (トランペット風) で演奏
F1 @2 g a b > c    ; @2 (ベル風) へ切り替え
F1 @FM1 < g f e d  ; @FM1 でも @1 と同じ音色を呼び出せる
