/* FM ステレオ定位 p のサンプルです */
; p は YM2151 の RL ビットを制御する FM トラック (F1-F8) 専用コマンドです。
; p0 = 無出力 / p1 = 左のみ / p2 = 右のみ / p3 = 左右 (中央・初期値)。

#TITLE "FM Panpot"
#COMPOSER "Hotate"
#OPM ON
#OCTAVE NORMAL

; --- FM 音色定義 @1 ---
@1 = {
  4, 6,
  31, 12,  0, 15,  3, 24, 0, 1, 0, 0, 0,
  31, 18,  0, 12,  5, 18, 0, 2, 3, 0, 0,
  31, 10,  0, 15,  2, 30, 0, 1, 0, 0, 0,
  31,  8,  0,  8,  4,  0, 0, 1, 0, 0, 0
}

F1 t120 o5 l4 @1 @v100 q7 p3
F1 cccc         ; p3 = 中央 (左右から鳴る・初期値)
F1 p1 dddd      ; p1 = 左のみ
F1 p2 eeee      ; p2 = 右のみ
F1 p3 ffff      ; p3 = 中央へ戻す
F1 p0 gggg      ; p0 = 無出力 (音が消える!)
F1 p3 aaaa      ; p3 = 復帰
