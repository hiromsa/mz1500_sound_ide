; ============================================================
; 歓喜の歌 (交響曲第9番 第4楽章 主題 / 1824)
; 原曲: L. v. Beethoven 〔著作権フリー: パブリックドメイン〕
; 構成: BEEP=メロディ / PSG ×2 (ベース・パッド) / N1=ノイズドラム
; BEEP は音量制御不可のため、音量コマンドは書いていません
; ============================================================
#TITLE "Ode to Joy"
#COMPOSER "L. v. Beethoven"
#OPM OFF
#OCTAVE NORMAL

t120

; --- B1: メロディ (BEEP は音量指定不可) ---
B1 L l4 o4
B1 f+4 f+4 g4 a4
B1 a4 g4 f+4 e4
B1 d4 d4 e4 f+4
B1 f+4. e8 e2
B1 f+4 f+4 g4 a4
B1 a4 g4 f+4 e4
B1 d4 d4 e4 f+4
B1 e4. d8 d2

; --- P1: ベース (根音と5度の8分刻み) ---
P1 L l8 o2 v11 q7
P1 d8 a8 d8 a8 d8 a8 d8 a8
P1 o2 a8 > e8 < a8 > e8 < a8 > e8 < a8
P1 d8 a8 d8 a8 d8 a8 d8 a8
P1 o2 a8 > e8 < a8 > e8 < a8 > e8 < a8
P1 d8 a8 d8 a8 d8 a8 d8 a8
P1 o2 a8 > e8 < a8 > e8 < a8 > e8 < a8
P1 d8 a8 d8 a8 d8 a8 d8 a8
P1 o2 a8 > e8 < a8 > e8 < a8 > e8 < a8

; --- P2: 和音パッド ---
P2 L l4 o3 v8
P2 d4 f+4 a2
P2 c+4 e4 a2
P2 d4 f+4 a2
P2 c+4 e4 a2
P2 d4 f+4 a2
P2 c+4 e4 a2
P2 d4 f+4 a2
P2 c+4 e4 a2

; --- N1: ノイズドラム (ホワイトノイズで拍子取り) ---
N1 L @WN1 v9 l4
N1 [c4 c8 c8 c4 c4]8
